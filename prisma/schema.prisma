// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth core models
// https://www.better-auth.com/docs/concepts/database#core-schema

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  InstrumentsOnUsers InstrumentsOnUsers[]
  UsersOnEvents      UsersOnEvents[]

  @@map("user")
}

model InstrumentsOnUsers {
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  instrumentId String

  @@id([userId, instrumentId])
}

model Instrument {
  id                 String               @id @default(cuid())
  name               String
  imageUrl           String?
  InstrumentsOnUsers InstrumentsOnUsers[]
}

model UsersOnEvents {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, eventId])
}

model Event {
  id            String          @id @unique @default(cuid())
  name          String
  start         DateTime?
  end           DateTime?
  state         Int             @default(0)
  email         String?
  phone         String?
  description   String?
  isPrivate     Boolean
  location      String?
  UsersOnEvents UsersOnEvents[]
}
